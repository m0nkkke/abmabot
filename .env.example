BOT_MODE=webhook
MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api2.max.ru
# Put russian_trusted_root_ca.cer and russian_trusted_sub_ca.cer into ./credentials.
# Docker entrypoint will add them to the container trust store on startup.
NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
WEBHOOK_URL=https://yourdomain.com/webhook
PORT=3000
MINIAPP_BASE_URL=https://yourdomain.com/miniapp/
MINIAPP_MAX_WEB_APP=
MINIAPP_AUTH_REQUIRED=false
MINIAPP_REQUIRE_MAX_INIT_DATA=false
MINIAPP_ALLOW_MAX_INIT_AUTH=false
MINIAPP_SESSION_TTL_MS=28800000
MINIAPP_SESSION_CLEANUP_INTERVAL_MS=3600000
MINIAPP_LOG_CLIENT_ERRORS=false
EMPLOYEE_ACCESS_PASSWORD=
OPERATOR_ACCESS_PASSWORD=
ADMIN_ACCESS_PASSWORD=
ADMIN_USER_IDS=
SEED_EMPLOYEES_FROM_JSON=false
GOOGLE_CREDENTIALS_PATH=./credentials/service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_URL=
GOOGLE_ONLINE_THEFT_SHEET_NAME=Онлайн кражи
GOOGLE_KSO_ASSIGNMENT_SHEET_ID=
GOOGLE_REPORTS_SHEET_ID=
GOOGLE_REPORTS_SHEET_NAME=Отчеты
GOOGLE_ANONYMOUS_FEEDBACK_SHEET_NAME=Анонимные обращения
GOOGLE_KSO_SHEET_NAME=Отписки КСО
GOOGLE_TECH_REPORTS_SHEET_ID=
GOOGLE_TECH_REPORTS_SHEET_NAME=Тех. неполадки
GOOGLE_REQUEST_TIMEOUT_MS=20000
GOOGLE_REQUEST_RETRIES=3
PHOTO_STORAGE_DIR=./storage/photos
PHOTO_PUBLIC_BASE_URL=https://yourdomain.com/photos
PHOTO_MAX_WIDTH=1600
PHOTO_WEBP_QUALITY=75
PHOTO_RETENTION_DAYS=30
PHOTO_CLEANUP_INTERVAL_MS=86400000
PD_OPERATOR_NAME=ООО "Название организации"
PD_PRIVACY_CONTACT=privacy@example.ru или ответственное лицо по ПДн
PD_PRIVACY_POLICY_URL=https://example.ru/privacy.pdf
